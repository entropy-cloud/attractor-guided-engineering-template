# install-age.manifest — Explicit list of scaffold files to copy into a target project.
#
# Format (one entry per line, relative to template root):
#   <src>                              → dst defaults to src (strip leading template/)
#   <src> > <dst>                      → dst differs from src
#   <src> > <dst> :: <flag>[,<flag>]   → with flags
#
# Flags:
#   exec             chmod +x the destination
#   fill             replace <project-name> with the project name
#   rel-mdh          replace __REL_MDH__ with the computed engine path (relative from target)
#   mdh-only         copied only with --with-mission-driver (engine add-on)
#   pi-only          copied only with --pi (pi runner bridge)
#   profile-frontend copied only with --profile frontend (or --profile all)
#   profile-java     copied only with --profile java (or --profile all)
#
# Lines starting with # are comments. The installer skips existing target files.
#
# v2 default excludes (by design, not omission):
#   mission-driver engine/missions/.env (add-on: --with-mission-driver)
#   docs/discussions|input|testing|references|retrospectives|examples|archive
#     (on-demand directories — created by the consumer when first needed,
#      see docs/guides/doc-organization.md)
#   docs/articles/ (methodology articles, template-repo only)
#   engine's own roadmaps/plans/audits/logs/requirements/retrospectives
# When adding new scaffold files to the template, add them HERE too.

# --- engine bootstrap (OPTIONAL: --with-mission-driver) ---
template/install/tools/mission-driver.sh > tools/mission-driver.sh :: exec,mdh-only
template/install/.env.example > .env.example :: rel-mdh,mdh-only
template/install/missions/base.json > missions/base.json :: mdh-only
template/install/missions/onboarding.json > missions/onboarding.json :: mdh-only
template/install/AGE-FILES-GUIDE.md > docs/references/age-files-guide.md :: mdh-only

# --- pi file bridge (--pi); derived from canonical operational skills ---
.agents/skills/nop-git/SKILL.md > .pi/skills/nop-git/SKILL.md :: pi-only
.agents/skills/nop-grillme/SKILL.md > .pi/skills/nop-grillme/SKILL.md :: pi-only

# --- root ---
template/AGENTS.md
template/START-HERE-after-copy.md > START-HERE-after-copy.md

# --- docs root ---
template/docs/index.md

# --- docs/context (mandatory AI context) ---
template/docs/context/project-context.md
template/docs/context/ai-autonomy-policy.md
template/docs/context/codebase-map.md
docs/context/README.md

