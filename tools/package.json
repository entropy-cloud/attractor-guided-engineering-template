{
  "name": "age-template-tools",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "check": "pnpm check:oversized-code-files && pnpm check:doc-references && pnpm check:docs-garbled",
    "check:oversized-code-files": "node ./check-oversized-code-files.mjs",
    "check:doc-references": "node ./check-doc-references.mjs",
    "check:docs-garbled": "node ./check-docs-garbled.mjs",
    "check:install": "bash ./check-install-age.sh",
    "check:duplicates": "node ./check-duplicates.mjs",
    "audit:suspects": "node ./audit/discover-audit-suspects.mjs",
    "stats": "node ./code-stats.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "md:test": "pnpm --filter mission-driver test",
    "md:web:build": "pnpm --filter mission-driver-monitor-web build",
    "md:web:check:dist": "pnpm --filter mission-driver-monitor-web check:dist",
    "install-age:test": "node --test ./install-age.test.mjs"
  },
  "devDependencies": {
    "jscpd": "^4.0.9",
    "prettier": "^3.8.3"
  }
}
