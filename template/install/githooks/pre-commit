#!/usr/bin/env bash
#
# pre-commit (consumer version) — document hygiene, fail-open.
#
# Enable (one-time, per clone):  git config core.hooksPath .githooks
#
# Runs the two standalone hygiene guards shipped with the template (zero npm
# deps; skipped individually when missing):
#   tools/check-doc-timeliness.mjs  — normative docs must carry no history
#                                     (docs/guides/doc-organization.md)
#   tools/check-docs-garbled.mjs    — encoding-garbled text detection
#
# Fail-open discipline: node unavailable → skip everything with a note (the
# hook must not be more fragile than the project's existing toolchain).
#
# With the add-on, staged plans/roadmaps/missions run the consumer-local engine's
# structural checkers. This checks working-tree files, not staged-blob identity.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 0

fail=0

if ! command -v node >/dev/null 2>&1; then
  echo "[pre-commit] (note) node not found — hygiene checks skipped (fail-open)"
  exit 0
fi

if [ -f tools/check-doc-timeliness.mjs ]; then
  if out=$(node tools/check-doc-timeliness.mjs 2>&1); then
    echo "[pre-commit][timeliness] ok"
  else
    echo "[pre-commit][timeliness] DENY:"
    printf '%s\n' "$out" | head -20
    fail=1
  fi
fi

if [ -f tools/check-docs-garbled.mjs ]; then
  if out=$(node tools/check-docs-garbled.mjs 2>&1); then
    printf '%s\n' "$out" | tail -5
  else
    echo "[pre-commit][garbled] DENY:"
    printf '%s\n' "$out" | head -20
    fail=1
  fi
fi

# ---- optional vendored engine structural sections -------------------------
engine=tools/mission-driver
if [ ! -d "$engine" ]; then
  echo "[pre-commit][engine] no add-on — structural sections skipped (fail-open)"
else
  for checker in gate-check roadmap-check mission-check; do
    if [ ! -f "$engine/src/$checker.mjs" ]; then
      echo "[pre-commit][engine] missing required checker: $checker" >&2
      fail=1
    fi
  done
  while IFS= read -r -d '' f; do
    [ -f "$f" ] || continue
    checker=
    case "$f" in
      docs/plans/*.md)
        if [ "$(head -n 1 "$f")" != "---" ]; then
          echo "[pre-commit][plans] legacy/non-ledger file skipped: $f"
          continue
        fi
        checker=gate-check ;;
      docs/roadmaps/*-roadmap.md) checker=roadmap-check ;;
      missions/*.json)
        # Installer convention: these are defaults/overrides, not missions.
        # Other JSON files must reach the real checker, even when malformed.
        case "$f" in missions/base.json|missions/base.local.json) continue ;; esac
        checker=mission-check ;;
    esac
    [ -n "$checker" ] || continue
    [ -f "$engine/src/$checker.mjs" ] || continue
    args=("$f")
    [ "$checker" != "mission-check" ] || args+=(".")
    if out=$(node "$engine/src/$checker.mjs" "${args[@]}" 2>&1); then
      echo "[pre-commit][$checker] ok: $f"
    else
      echo "[pre-commit][$checker] DENY: $f"
      printf '%s\n' "$out" | head -15
      fail=1
    fi
  done < <(git diff --cached --name-only --diff-filter=ACMR -z)
fi

exit "$fail"
